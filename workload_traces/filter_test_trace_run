# PUT_META_ONLY Tests - Updating only metadata
# ============================================
# Update gdpr2's purposes without changing data
query(PUT("gdpr2","meta_only"))&sessionKey("user1")&objPur("purpose7,purpose8")
# Verify the metadata was updated - first should succeed, second should fail
query(GET("gdpr2","meta_only"))&sessionKey("user1")&objPurIs("purpose7")
