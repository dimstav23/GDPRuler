# Delete all del* keys owned by user1 with purpose1
query(DELETEM("del"))&sessionKey("user1")&objPurIs("purpose1,purpose2")
# Verify del1 and del2 are deleted (owned by user1, matching filter)
query(GET("del1"))&sessionKey("user1")&objPurIs("purpose1")
query(GET("del2"))&sessionKey("user1")&objPurIs("purpose1")
# Verify del3 still exists (owned by user2, not affected)
query(GET("del3"))&sessionKey("user2")&objPurIs("purpose3")
# Try to delete as non-owner (should not delete keys owned by others)
query(PUT("ownership1","VAL"))&sessionKey("user1")&objPur("purpose1,purpose2")&objExp("0")
query(PUT("ownership2","VAL"))&sessionKey("user1")&objPur("purpose1,purpose2")&objExp("0")
query(DELETEM("ownership"))&sessionKey("user2")&objPurIs("purpose1")
# Verify keys still exist (user2 doesn't own them)
query(GET("ownership1"))&sessionKey("user1")&objPurIs("purpose1")
query(GET("ownership2"))&sessionKey("user1")&objPurIs("purpose1")
