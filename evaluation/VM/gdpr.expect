#!/usr/bin/expect -f

set timeout -1

set curr_dir [file normalize [file dirname $argv0]]

# indicates the db backend type: redis or rocksdb
set db_type [lindex $argv 0];
# indicates the number of cores
set cores [lindex $argv 1];
# indicates the MB of memory for the VM
set memory [lindex $argv 2];
# indicates the Unix socket path for DB communication
set db_socket_path [lindex $argv 3];
# indicates the controller address for communication
set controller_address [lindex $argv 4];
# indicates the controller port for communication
set controller_port [lindex $argv 5];
# indicates the directory of the logs
set log_dir [lindex $argv 6];
# indicates the server output file path
set server_output_file [lindex $argv 7];
# indicates the controller output file path
set controller_output_file [lindex $argv 8];
# indicates the gdpr log path
# set gdpr_log_path [lindex $argv 9];

# Set the server executables
set rocksdb_server_bin /root/GDPRuler/controller/build/rocksdb_server
set redis_server_bin /root/GDPRuler/KVs/redis/src/redis-server

# Launch the VM
spawn sudo LD_LIBRARY_PATH=$::env(LD_LIBRARY_PATH) numactl --cpunodebind=0 --membind=0   \
bash ${curr_dir}/../../CVM_setup/AMDSEV/launch-qemu.sh \
-hda ${curr_dir}/../../CVM_setup/images/gdpr.img \
-sev-snp \
-bridge virbr0 \
-bios ${curr_dir}/../../CVM_setup/firmware/gdpr \
-smp $cores \
-mem $memory \
-log ${curr_dir}/gdpr.out

# Enter username
expect -- "login: "
send -- "root\r"

# Enter Password
expect -- "Password: "
send -- "123456\r"

# Expect the login to be done
expect -- "# "

# Go to the controller directory
send -- "cd /root/GDPRuler/controller\r"
expect -- "# "

# Delete and recreate the folders for the db files and logs
send -- "rm -rf $log_dir\r"
expect -- "# "
send -- "mkdir -p $log_dir\r"
expect -- "# "

# Clean up any existing socket files
send -- "rm -f $db_socket_path\r"
expect -- "# "

# Start the appropriate DB server in background
if { $db_type == "rocksdb" } {
  # Run rocksdb server with Unix socket (assuming it supports --socket parameter)
  send -- "$rocksdb_server_bin --unix $db_socket_path $log_dir > $server_output_file 2>&1 &\r"
  expect -- "# "
} elseif { $db_type == "redis" } {
  # Run redis server with Unix socket
  send -- "$redis_server_bin --port 0 --unixsocket $db_socket_path --unixsocketperm 700 --dir $log_dir --protected-mode no > $server_output_file 2>&1 &\r"
  expect -- "# "
} else {
  send_user "Error: Invalid DB backend '$db_type'\n"
  exit 1
}

# Go to GDPRuler directory
send -- "cd /root/GDPRuler\r"
expect -- "# "

# Start the GDPR controller in background with Unix socket communication
send -- "python3 scripts/GDPRuler.py --db $db_type --logpath $log_dir --controller_address $controller_address --controller_port $controller_port > $controller_output_file\r"
expect -- "# "
